+  async getContentChannelGrant(): Promise<string> {
+    if (!("chatId" in this.caller)) return "";
+    const chatId = this.caller.chatId;
+    const chat = [...this.impl.storage.externalChats.list()].find(entry => entry.chatId === chatId);
+    if (!chat) return "";
+    const marker = chat.externalChatKey.indexOf(":telegram:");
+    if (marker < 0) return "";
+    const parts = chat.externalChatKey.slice(marker + 10).split(":");
+    return `${parts[0]}:${parts[1]}`;
+  }
