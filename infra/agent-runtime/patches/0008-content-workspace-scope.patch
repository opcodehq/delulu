   private impl: OverseerImpl;
 
+  async bindContentWorkspace(workspaceId: string): Promise<void> {
+    if (!workspaceId || workspaceId.length > 200) throw new Error("Invalid content workspace");
+    const current = this.impl.storage.contentWorkspaceId.get();
+    if (current && current !== workspaceId) throw new Error("Content workspace cannot change");
+    this.impl.storage.contentWorkspaceId.put(workspaceId);
+  }
