{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "delulu-social",
  "compatibility_date": "2024-12-30",
  "vars": {
    "MAINTENANCE_MODE": "false",
    // Default API origin. The staging/production envs below override this; a
    // plain `wrangler deploy` (no --env) picks up production's public API.
    "NEXT_PUBLIC_API_URL": "https://api.delulu.social"
  },
  "placement": {
    "mode": "smart"
  },
   "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "keep_vars": true,
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
    "enable_request_signal"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      // The service should match the "name" of your worker
      "service": "delulu-social"
    }
  ],
  "env": {
    "staging": {
      "name": "delulu-web-staging",
      "workers_dev": true,
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "delulu-web-staging" }],
      "r2_buckets": [{ "binding": "DELULU_SOCIAL_BUCKET", "bucket_name": "delulu-staging-assets" }],
      "kv_namespaces": [{ "binding": "DELULU_FACEBOOK_PAGES", "id": "3cf83d1a675b45f39790f0ee9be53499" }],
      "vars": {
        "MAINTENANCE_MODE": "false",
        "NEXT_PUBLIC_API_URL": "https://delulu-staging.whizzy.workers.dev",
        "NEXT_PUBLIC_ANALYTICS_DISABLED": "true",
        "NEXT_PUBLIC_APP_URL": "https://delulu-web-staging.whizzy.workers.dev",
        "NEXT_PUBLIC_WEB_URL": "https://delulu.social",
        "NEXT_PUBLIC_DOCS_URL": "https://docs.delulu.social",
        "NEXT_PUBLIC_POSTHOG_KEY": "phc_A5NWdEHAyUyzoUUSKnemshpamt3MCdbh9ztSxH0RvQV",
        "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "NEXT_PUBLIC_POSTHOG_PROXY_HOST": "https://metrics.delulu.social",
        "NEXTJS_ENV": "production"
      }
    },
    "production": {
      "vars": {
        "MAINTENANCE_MODE": "false",
        "NEXT_PUBLIC_API_URL": "https://api.delulu.social",
        "NEXT_PUBLIC_APP_URL": "https://solulu.delulu.social",
        "NEXT_PUBLIC_WEB_URL": "https://delulu.social",
        "NEXT_PUBLIC_DOCS_URL": "https://docs.delulu.social",
        "NEXT_PUBLIC_POSTHOG_KEY": "phc_A5NWdEHAyUyzoUUSKnemshpamt3MCdbh9ztSxH0RvQV",
        "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
        "NEXT_PUBLIC_POSTHOG_PROXY_HOST": "https://metrics.delulu.social",
        "NEXTJS_ENV": "production"
      }
    }
  },
  "r2_buckets": [
    {
      "binding": "DELULU_SOCIAL_BUCKET",
      "bucket_name": "delulu-social",
      "preview_bucket_name": "delulu-social-dev"
    },
    // Blog articles bucket — shared with apps/web. Reads are served by the
    // landing worker; this binding is here so future tRPC procedures (or admin
    // tooling on apps/app) can also read articles.
    {
      "binding": "DELULU_ARTICLES_BUCKET",
      "bucket_name": "delulu-articles",
      "preview_bucket_name": "delulu-articles-dev"
    }
  ],
  // KV namespace for storing Facebook pages data temporarily
  "kv_namespaces": [
    {
      "binding": "DELULU_FACEBOOK_PAGES",
      "id": "e4eecde6b80f429b94485436a905c864",
      "preview_id": "8763e908a84c4725a860b33307d47c80"
    },
    {
      "binding": "DELULU_ARTICLES_KV",
      "id": "6604544fdc7e4f9f9537d726552eb868",
      "preview_id": "3dbe94bc460442aea16f46f44dac3435"
    }
  ]
}
