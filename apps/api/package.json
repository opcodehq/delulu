{
  "name": "@delulu/http-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:staging": "wrangler dev --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "start:node": "tsx src/node.ts",
    "build:cloudflare": "node ../../scripts/run-cloudflare-production-migration.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:durable-runtime": "node scripts/smoke-durable-jobs.mjs"
  },
  "dependencies": {
    "@delulu/communication-telegram": "workspace:*",
    "@delulu/communication-whatsapp": "workspace:*",
    "@delulu/analytics": "workspace:*",
    "@delulu/contracts": "workspace:*",
    "@delulu/core": "workspace:*",
    "@delulu/email": "workspace:*",
    "@delulu/payments": "workspace:*",
    "@delulu/services": "workspace:*",
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:",
    "tsx": "^4.20.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "@delulu/typescript-config": "workspace:*",
    "esbuild": "0.28.1",
    "miniflare": "4.20260708.1",
    "typescript": "catalog:",
    "vitest": "^3.1.1",
    "wrangler": "^4.110.0"
  }
}
